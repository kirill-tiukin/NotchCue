    "Adjust input volume and select microphone in System Settings, and restart voice activation to apply changes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Eingangslautstärke an und wählen Sie das Mikrofon in den Systemeinstellungen aus. Starten Sie die Sprachaktivierung neu, um die Änderungen zu übernehmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust input volume and select microphone in System Settings, and restart voice activation to apply changes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el volumen de entrada y selecciona el micrófono en Configuración del Sistema, y reinicia la activación por voz para aplicar los cambios"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le volume d’entrée et sélectionnez le microphone dans Réglages Système, puis redémarrez l’activation vocale pour appliquer les modifications"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola il volume di ingresso e seleziona il microfono in Impostazioni di Sistema, quindi riavvia l’attivazione vocale per applicare le modifiche"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj głośność i wybierz mikrofon w Ustawieniach systemowych, a następnie zrestartuj aktywację głosową, aby zastosować zmiany"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o volume de entrada e selecione o microfone em Ajustes do Sistema e reinicie a ativação por voz para aplicar as alterações"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o volume de entrada e selecione o microfone em Ajustes do Sistema e reinicie a ativação por voz para aplicar as alterações"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları'nda giriş ses düzeyini ayarlayıp mikrofonu seçin. Değişiklikleri uygulamak için sesle etkinleştirmeyi yeniden başlatın."
          }
        }
      }
    },
    "Adjust input volume and select microphone in System Settings. Restart voice activation to apply changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Eingangslautstärke an und wählen Sie das Mikrofon in den Systemeinstellungen aus. Starten Sie die Spracherkennung neu, um die Änderungen zu übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust input volume and select microphone in System Settings. Restart voice activation to apply changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el volumen de entrada y selecciona el micrófono en Configuración del Sistema. Reinicia la activación por voz para aplicar los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le volume d’entrée et sélectionnez le microphone dans Réglages du système. Redémarrez l’activation vocale pour appliquer les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola il volume di ingresso e seleziona il microfono nelle Impostazioni di Sistema. Riavvia l’attivazione vocale per applicare le modifiche."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj głośność wejściową i wybierz mikrofon w Ustawieniach systemowych. Uruchom ponownie aktywację głosową, aby zastosować zmiany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o volume de entrada e selecione o microfone em Ajustes do Sistema. Reinicie a ativação por voz para aplicar as alterações."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o volume de entrada e selecione o microfone em Ajustes do Sistema. Reinicie a ativação por voz para aplicar as alterações."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları'nda giriş ses düzeyini ayarlayın ve mikrofonu seçin. Değişiklikleri uygulamak için sesle etkinleştirmeyi yeniden başlatın."
          }
        }
      }
    },
    "Adjust sensitivity for voice detection. Lower values detect quieter speech." : {
      "comment" : "A description of the slider that adjusts the sensitivity of voice detection.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfindlichkeit für Spracherkennung anpassen. Niedrigere Werte erkennen leisere Sprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust sensitivity for voice detection. Lower values detect quieter speech."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la sensibilidad para la detección de voz. Los valores más bajos detectan voces más suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez la sensibilité de la détection vocale. Des valeurs plus basses détectent des voix plus discrètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la sensibilità per il rilevamento vocale. Valori più bassi rilevano voci più basse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj czułość wykrywania głosu. Niższe wartości wykrywają cichszą mowę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste a sensibilidade para detecção de voz. Valores menores detectam vozes mais baixas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta a sensibilidade para detecção de voz. Valores mais baixos detectam fala mais baixa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses algılama hassasiyetini ayarlayın. Daha düşük değerler daha sessiz konuşmaları algılar.\n\n"
          }
        }
      }
    },
